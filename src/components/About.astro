---
import { site } from "../data/site";
import SectionHeading from "./SectionHeading.astro";
---

<section class="section about" id="a-propos" aria-labelledby="about-title">
  <div class="about-image-wrap reveal">
    <span class="image-index" aria-hidden="true">01</span>
    <img src={site.about.image} alt={site.about.imageAlt} loading="lazy" width="1068" height="1600" />
  </div>
  <div class="about-copy reveal">
    <SectionHeading eyebrow={site.about.eyebrow} title={site.about.title} />
    <p class="about-role" id="about-title">{site.about.role}</p>
    <p class="lead-copy">{site.about.biography}</p>
    <div class="about-perspective">
      <p class="about-perspective-title">{site.about.philosophy.question}</p>
      <div class="about-perspective-grid">
        <article>
          <span>01</span>
          <h3>Sommelier</h3>
          <p>{site.about.philosophy.sommelier}</p>
        </article>
        <article>
          <span>02</span>
          <h3>Œnologue</h3>
          <p>{site.about.philosophy.oenologue}</p>
        </article>
      </div>
    </div>
  </div>
</section>
