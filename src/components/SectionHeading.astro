---
type Props = { eyebrow: string; title: string; id?: string; description?: string; light?: boolean };
const { eyebrow, title, id, description, light = false } = Astro.props;
---

<header class:list={["section-heading", { "section-heading-light": light }]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id}>{title}</h2>
  {description && <p class="section-intro">{description}</p>}
</header>
