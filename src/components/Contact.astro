---
import { site } from "../data/site";

const isPlaceholder = (value: string | undefined) => !value || value.startsWith("[");
const emailHref = isPlaceholder(site.contact.email) ? undefined : `mailto:${site.contact.email}`;
const phoneHref = isPlaceholder(site.contact.phone) ? undefined : `tel:${site.contact.phone.replace(/\s/g, "")}`;
const linkedinHref = isPlaceholder(site.contact.linkedin) ? undefined : site.contact.linkedin;
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="section contact-inner">
    <p class="eyebrow reveal">{site.contact.eyebrow}</p>
    <div class="contact-grid">
      <div class="reveal">
        <h2 id="contact-title">{site.contact.title}</h2>
        <p>{site.contact.description}</p>
      </div>
      <address class="contact-links reveal">
        <div><span>{site.contact.labels.email}</span>{emailHref ? <a href={emailHref}>{site.contact.email}</a> : <strong>{site.contact.email}</strong>}</div>
        <div><span>{site.contact.labels.phone}</span>{phoneHref ? <a href={phoneHref}>{site.contact.phone}</a> : <strong>{site.contact.phone}</strong>}</div>
        <div><span>{site.contact.labels.linkedin}</span>{linkedinHref ? <a href={linkedinHref} target="_blank" rel="noreferrer">{site.contact.linkedinLabel}</a> : <strong>{site.contact.linkedinLabel}</strong>}</div>
      </address>
    </div>
  </div>
</section>
